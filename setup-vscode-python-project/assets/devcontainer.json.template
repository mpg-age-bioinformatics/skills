{
  "name": "Python __PYTHON_VERSION__ Development",
  "image": "mcr.microsoft.com/devcontainers/python:__PYTHON_VERSION__-bookworm",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-toolsai.jupyter", "charliermarsh.ruff", "REditorSupport.r", "openai.chatgpt", "anthropic.claude-code"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.analysis.typeCheckingMode": "basic",
        "workbench.panel.defaultLocation": "bottom",
        "workbench.sideBar.location": "left",
        "workbench.startupEditor": "none",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [1455],
  "portsAttributes": {
    "1455": {
      "label": "Codex authentication callback",
      "onAutoForward": "silent",
      "requireLocalPort": true
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.codex-home,target=/home/vscode/.codex,type=bind",
    "source=${localWorkspaceFolder}/skills,target=/home/vscode/.codex/skills,type=bind,readonly",
    "source=${localWorkspaceFolder}/.claude-home,target=/home/vscode/.claude,type=bind",
    "source=${localWorkspaceFolder}/skills,target=/home/vscode/.claude/skills,type=bind,readonly"
  ],
  "postCreateCommand": "test -x .venv/bin/python || python -m venv .venv",
  "remoteUser": "vscode",
  "shutdownAction": "stopContainer"
}
