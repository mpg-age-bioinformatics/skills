// Uses an independent Docker daemon inside the Dev Container.
// Feature documentation: https://github.com/devcontainers/features/tree/main/src/docker-in-docker
{
	"name": "Docker-in-Docker AI Development",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:3": {
			"version": "latest",
			"moby": true,
			"dockerDashComposeVersion": "v2",
			"installDockerBuildx": true
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"openai.chatgpt",
				"anthropic.claude-code"
			]
		}
	},

	"forwardPorts": [1455],

	"portsAttributes": {
		"1455": {
			"label": "Codex authentication callback",
			"onAutoForward": "silent",
			"requireLocalPort": true
		}
	},

	// Persist agent state and expose the cloned skills repository read-only to both agents.
	"mounts": [
		"source=${localWorkspaceFolder}/.codex-home,target=/home/vscode/.codex,type=bind",
		"source=${localWorkspaceFolder}/skills,target=/home/vscode/.codex/skills,type=bind,readonly",
		"source=${localWorkspaceFolder}/.claude-home,target=/home/vscode/.claude,type=bind",
		"source=${localWorkspaceFolder}/skills,target=/home/vscode/.claude/skills,type=bind,readonly"
	],

	"remoteUser": "vscode",
	"shutdownAction": "stopContainer"
}
