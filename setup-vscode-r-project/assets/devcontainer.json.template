{
  "name": "R __R_VERSION__ Development",
  "image": "ghcr.io/rocker-org/devcontainer/r-ver:__R_VERSION__",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/r-packages:1": {
      "packages": "languageserver,httpgd,renv,rmarkdown",
      "installSystemRequirements": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["REditorSupport.r", "RDebugger.r-debugger", "quarto.quarto", "openai.chatgpt"],
      "settings": {
        "r.alwaysUseActiveTerminal": true,
        "r.bracketedPaste": true,
        "r.plot.useHttpgd": true,
        "r.sessionWatcher": true,
        "workbench.panel.defaultLocation": "bottom",
        "workbench.sideBar.location": "left",
        "workbench.startupEditor": "none",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [1455],
  "portsAttributes": {
    "1455": {
      "label": "Codex authentication callback",
      "onAutoForward": "silent",
      "requireLocalPort": true
    }
  },
  "containerEnv": {
    "R_LIBS_USER": "/home/rstudio/R/library"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.codex-home,target=/home/rstudio/.codex,type=bind",
    "source=${localWorkspaceFolder}/.r-library,target=/home/rstudio/R/library,type=bind"
  ],
  "remoteUser": "rstudio",
  "shutdownAction": "stopContainer"
}
